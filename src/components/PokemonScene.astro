---
// The Pokémon theme's backdrop: a night-time route, back to front — banded sky, stars,
// moon, drifting clouds, mountains, pine trees, fireflies, then tall grass with a patch
// that rustles now and then. Static markup animated by src/styles/themes/pokemon.css;
// the art is generated by scripts/pokemon-scenery.py. Hidden in every other theme.

// Seeded, so the fireflies sit in the same places on every build.
let seed = 25;
const rand = () => {
  seed = (seed * 1664525 + 1013904223) % 4294967296;
  return seed / 4294967296;
};

const fireflies = Array.from({ length: 10 }, () => ({
  x: `${(rand() * 94 + 3).toFixed(1)}%`,
  y: `${Math.round(rand() * 130 + 60)}px`,
  duration: `${(rand() * 5 + 7).toFixed(1)}s`,
  delay: `-${(rand() * 12).toFixed(1)}s`,
}));

// Where the rustling patches sit, and when each one shakes in the cycle.
const rustles = [
  { x: "14%", delay: "-2s" },
  { x: "61%", delay: "-6.5s" },
  { x: "87%", delay: "-10s" },
];
---

<div class="pkmn-only pkmn-scene" aria-hidden="true">
  <div class="pkmn-stars pkmn-stars-dim"></div>
  <div class="pkmn-stars pkmn-stars-mid"></div>
  <div class="pkmn-stars pkmn-stars-bright"></div>
  <div class="pkmn-moon"></div>
  <div class="pkmn-cloud pkmn-cloud-near"></div>
  <div class="pkmn-cloud pkmn-cloud-far"></div>
  <div class="pkmn-mountains"></div>
  <div class="pkmn-trees"></div>
  {
    fireflies.map(({ x, y, duration, delay }) => (
      <span class="pkmn-firefly" style={`--x:${x};--y:${y};--duration:${duration};--delay:${delay}`} />
    ))
  }
  <div class="pkmn-grass"></div>
  {rustles.map(({ x, delay }) => <div class="pkmn-rustle" style={`--x:${x};--delay:${delay}`} />)}
</div>
