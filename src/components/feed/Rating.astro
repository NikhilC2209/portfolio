---
// Five short bars, filled to the nearest half.
interface Props {
  value: number;
}
const { value } = Astro.props;
const cells = [1, 2, 3, 4, 5].map((n) => (value >= n ? 'full' : value >= n - 0.5 ? 'half' : 'empty'));
---

<span class="rating inline-flex gap-1" role="img" aria-label={`Rated ${value} out of 5`}>
  {cells.map((cell) => <span class:list={['block h-[7px] w-5', cell]}></span>)}
</span>

<style>
  .rating .full {
    background: rgb(var(--c-heading));
  }
  .rating .half {
    background: linear-gradient(90deg, rgb(var(--c-heading)) 50%, rgb(var(--c-heading) / 0.2) 50%);
  }
  .rating .empty {
    background: rgb(var(--c-heading) / 0.2);
  }
</style>
