---
const { article, tags, link } = Astro.props
---
 
<article class="">
    <a class="hud-card" href={`/${link}`}>
        <div class="thought-card max-w-sm border mx-auto shadow bg-gray-950 dark:border-gray-700 mb-20 h-[30rem]">
            <img class="hover:grayscale transition ease-in-out duration-300" src={article.image?.filename} alt="" />
            <div class="p-5 pt-0">
                <p class="mt-4 mb-1 text-sm">📅 {article.date}</p>
                <h2 class="mb-2 text-xl">{article.title}</h2>
                <p class="mb-3 font-normal text-text mt-3">{article.description}</p>
            </div>
        </div>
    </a>
</article>
