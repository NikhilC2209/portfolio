---
import Nav from "../components/navbar/Nav";
import TopButton from "../components/TopButton";
import Pointer from "../components/Pointer";
import { themeCss, defaultTheme, themeIds, storageKey, themePreloads, trailStorageKey, trailPaletteIds } from "../data/themes.js";

const { title } = Astro.props;
// const posts = await Astro.glob("../pages/posts/*.md");
const posts = ""

import "../styles/global.css";
import "../styles/themes/cyberpunk.css";
---

<!doctype html>
<html lang="en" class="dark" data-theme={defaultTheme}>
  <head>
    <meta charset="UTF-8" />
    <style set:html={themeCss}></style>
    <script is:inline define:vars={{ themeIds, defaultTheme, storageKey, themePreloads, trailStorageKey, trailPaletteIds }}>
      // Applies the saved theme before first paint so the page never flashes
      // the default palette on the way to the chosen one.
      (function () {
        var theme = defaultTheme;
        try {
          var stored = window.localStorage.getItem(storageKey);
          if (stored && themeIds.indexOf(stored) !== -1) theme = stored;
        } catch (e) {
          /* storage blocked — fall back to the default */
        }
        document.documentElement.dataset.theme = theme;

        // Restore the cursor-trail palette the visitor last clicked to.
        try {
          var trail = window.localStorage.getItem(trailStorageKey);
          if (trail && (trailPaletteIds[theme] || []).indexOf(trail) !== -1) {
            document.documentElement.dataset.trail = trail;
          }
        } catch (e) {
          /* storage blocked — use the theme's first palette */
        }

        // Start fetching this theme's self-hosted fonts now, rather than when the
        // stylesheet is parsed, to shorten the fallback-font flash.
        (themePreloads[theme] || []).forEach(function (href) {
          var link = document.createElement("link");
          link.rel = "preload";
          link.as = "font";
          link.type = "font/woff2";
          link.crossOrigin = "anonymous";
          link.href = href;
          document.head.appendChild(link);
        });
      })();
    </script>
    <meta
      name="description"
      content="Nikhil Chapre — full stack developer and CS grad student at Arizona State University. Blog posts, CTF writeups, and projects across web development, security, and computer vision."
    />
    <meta name="keywords" content="Nikhil Chapre, portfolio, full stack developer, CTF writeups, computer vision, web development" />
    <meta name="author" content="Nikhil Chapre" />
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link
      rel="alternate"
      type="application/rss+xml"
      title="c0smos.dev"
      href={`${Astro.site}rss.xml`}
    />
    <meta name="generator" content={Astro.generator} />
    <script type="text/javascript">
      (function () {
        var css = document.createElement("link");
        css.href =
          "https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css";
        css.rel = "stylesheet";
        css.integrity =
          "sha512-DTOQO9RWCH3ppGqcWaEA1BIZOC6xxalwEsw9c2QQeAIftl+Vegovlnee1c9QX4TctnWMn13TZye+giMm8e2LwA==";
        css.crossOrigin = "anonymous";
        css.referrerPolicy = "no-referrer";
        document.head.appendChild(css);
      })();
    </script>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Roboto:ital,wght@0,100;0,300;0,400;0,500;0,700;0,900;1,100;1,300;1,400;1,500;1,700;1,900&display=swap"
      rel="stylesheet"
    />
    <link
      href="https://cdn.jsdelivr.net/npm/normalize.css@8.0.1/normalize.min.css"
      rel="stylesheet"
    />
    <title>{title}</title>
  </head>
  <body class="bg-primary w-full mx-auto bg-[url('/tile_background4.png')]">
    <Nav client:visible posts={posts} />
    {/* <div class="container px-4 w-full lg:w-9/12 mx-auto"> */}
    <div class="container px-4 w-full mx-auto">
      <slot />
    </div>
    <TopButton client:only />
    <Pointer client:only />
  </body>
</html>
