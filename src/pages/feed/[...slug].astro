---
import { getCollection } from 'astro:content';
import { Image, getImage } from 'astro:assets';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Rating from '../../components/feed/Rating.astro';
import Arrow from '../../components/Arrow.astro';
import { formatDate, hasBody, headingSize, inlineMd, isLandscape, kindOf, labelOf, titleOf } from '../../components/feed/feed';
import '../../styles/blog.css';

export async function getStaticPaths() {
  const entries = await getCollection('feed');
  return entries.map((entry) => ({ params: { slug: entry.slug }, props: { entry } }));
}

const { entry } = Astro.props;
const { data } = entry;
const kind = kindOf(entry);
const { Content } = await entry.render();

// A collage's lightbox opens each picture at full size (capped at 1600px wide).
const gallery = data.gallery
  ? await Promise.all(
      data.gallery.map(async (item) => ({
        ...item,
        full: (await getImage({ src: item.src, width: Math.min(1600, item.src.width), format: 'webp' })).src,
      })),
    )
  : [];
---

<BaseLayout title={`${titleOf(entry)} · Feed`}>
  <article class:list={['mx-auto my-12 w-11/12 flex flex-col gap-6', kind === 'collage' ? 'max-w-7xl' : 'max-w-3xl']}>
    <a href="/feed" class="font-heading text-sm uppercase tracking-[0.08em] text-dk-text hover:text-accent"><Arrow dir="left" class="mr-1" /> Feed</a>
    <span class="font-mono text-xs tracking-[0.14em] uppercase text-accent" data-hud="/// FEED.ENTRY">{formatDate(data.date)} · {labelOf(entry)}</span>

    {kind === 'quote' && data.quote && (
      <!-- A portrait picture floats top-right and the quote wraps around it, running full
           width once it clears the picture; a landscape one goes under the quote, full width. -->
      <div class="flow-root">
        {data.image && !isLandscape(data.image) && (
          <Image src={data.image} alt={data.alt} widths={[600, 1200]} sizes="(min-width: 768px) 320px, 100vw" class="hud-frame block w-full h-auto mb-6 md:float-right md:w-2/5 md:ml-8 md:mt-4" />
        )}
        <!-- Block flow, not flex: only line boxes wrap around a float. -->
        <blockquote class="m-0 pt-4 space-y-4">
          <span class="block font-display text-8xl leading-[0.5] h-[0.45em] text-secondary" aria-hidden="true">“</span>
          <p class:list={['m-0 font-display text-secondary whitespace-pre-line', headingSize(data.quote.text, 'page', 0, data.size)]}>{data.quote.text}</p>
          <p class="m-0 font-mono text-sm tracking-wide text-dk-text">
            <b class="font-semibold text-secondary">{data.quote.by}</b>{data.quote.source && ` · ${data.quote.source}`}
          </p>
        </blockquote>
        {data.image && isLandscape(data.image) && (
          <Image src={data.image} alt={data.alt} widths={[800, 1600]} sizes="(min-width: 768px) 768px, 100vw" class="hud-frame block w-full h-auto mt-8" />
        )}
      </div>
    )}

    {kind !== 'quote' && data.image && (
      <Image src={data.image} alt={data.alt} widths={[800, 1600]} sizes="(min-width: 768px) 768px, 100vw" class="hud-frame block w-full h-auto" />
    )}
    {kind === 'photo' && data.caption && <p class="caption m-0 font-mono text-sm text-dk-text" set:html={inlineMd(data.caption)} />}

    {kind !== 'media' && kind !== 'quote' && data.title && (
      <h1 class:list={['m-0 font-display whitespace-pre-line', headingSize(data.title, 'page', 0, data.size)]}>{data.title}</h1>
    )}

    {kind === 'media' && data.media && (
      <header class="flex flex-col gap-3">
        <h1 class:list={['m-0 font-display whitespace-pre-line', headingSize(data.media.title, 'page', 0, data.size)]}>{data.media.title}</h1>
        <div class="flex items-center gap-2 font-mono text-sm text-dk-text">
          {data.media.rating !== undefined && <Rating value={data.media.rating} />}
          {data.media.rating !== undefined && <span>{data.media.rating.toFixed(1)}</span>}
          {data.media.meta && <span>· {data.media.meta}</span>}
        </div>
      </header>
    )}

    {kind === 'link' && data.link && (
      <a href={data.link.url} target="_blank" rel="noopener" class="flex items-center gap-4 border border-secondary/20 p-4 hover:border-accent">
        <span class="flex min-w-0 flex-col gap-1">
          <span class="font-heading text-lg text-secondary">{data.link.title} ↗</span>
          <span class="font-mono text-xs text-dk-text">{new URL(data.link.url).hostname.replace(/^www\./, '')}</span>
        </span>
      </a>
    )}

    {hasBody(entry) && (
      <div class="content">
        <Content />
      </div>
    )}
    {kind === 'collage' && !hasBody(entry) && data.caption && <p class="caption m-0 font-mono text-sm text-dk-text" set:html={inlineMd(data.caption)} />}

    {kind === 'collage' && (
      <>
        <!-- Pictures at their own shapes, packed into columns, each in a card like the
             blog's (.hud-card gives it the theme's card border). Each is a plain link
             to the full-size file; with JS the link opens the lightbox instead. -->
        <div class="gallery columns-1 sm:columns-2 gap-3" data-gallery>
          {gallery.map((item, i) => (
            <a href={item.full} class="hud-card block mb-3 break-inside-avoid" data-index={i} data-caption={item.caption ? inlineMd(item.caption) : item.alt}>
              <div class="border border-secondary/50 bg-surface transition duration-300 hover:border-accent">
                <Image src={item.src} alt={item.alt} widths={[640, 1280]} sizes="(min-width: 1280px) 620px, (min-width: 640px) 50vw, 100vw" class="block w-full h-auto" loading="lazy" />
                {item.caption && <span class="caption block px-2 py-1.5 font-mono text-[11px] text-dk-text" set:html={inlineMd(item.caption)} />}
              </div>
            </a>
          ))}
        </div>
        <p class="m-0 font-mono text-xs tracking-[0.08em] text-dk-text">Click a picture to open it · arrow keys move through the set · Esc closes</p>

        <dialog data-lightbox class="m-0 h-full max-h-none w-full max-w-none bg-black/90 p-0 text-white backdrop:bg-black/80">
          <div class="flex h-full flex-col items-center justify-center gap-3 p-4">
            <img data-lightbox-img src="" alt="" class="max-h-[85vh] max-w-full object-contain" />
            <p data-lightbox-caption class="caption m-0 min-h-5 font-mono text-xs text-white/70"></p>
          </div>
          <button type="button" data-lightbox-prev aria-label="Previous picture" class="absolute left-2 top-1/2 -translate-y-1/2 h-11 w-11 bg-black/40 flex items-center justify-center hover:bg-black/70"><Arrow dir="left" class="text-xl" /></button>
          <button type="button" data-lightbox-next aria-label="Next picture" class="absolute right-2 top-1/2 -translate-y-1/2 h-11 w-11 bg-black/40 flex items-center justify-center hover:bg-black/70"><Arrow class="text-xl" /></button>
          <button type="button" data-lightbox-close aria-label="Close" class="absolute right-2 top-2 h-11 w-11 bg-black/40 font-mono text-xl hover:bg-black/70">✕</button>
        </dialog>
      </>
    )}
  </article>
</BaseLayout>

<script>
  // Collage lightbox: a native <dialog> showing one picture at a time.
  const gallery = document.querySelector<HTMLElement>('[data-gallery]');
  const dialog = document.querySelector<HTMLDialogElement>('[data-lightbox]');
  if (gallery && dialog && typeof dialog.showModal === 'function') {
    const links = Array.from(gallery.querySelectorAll<HTMLAnchorElement>('a[data-index]'));
    const img = dialog.querySelector<HTMLImageElement>('[data-lightbox-img]')!;
    const caption = dialog.querySelector<HTMLElement>('[data-lightbox-caption]')!;
    let current = 0;

    const show = (i: number) => {
      current = (i + links.length) % links.length;
      const link = links[current];
      img.src = link.href;
      img.alt = link.querySelector('img')?.alt ?? '';
      // Captions are inline markdown rendered to HTML at build time (see inlineMd).
      caption.innerHTML = link.dataset.caption ?? '';
    };

    links.forEach((link, i) =>
      link.addEventListener('click', (event) => {
        event.preventDefault();
        show(i);
        dialog.showModal();
      }),
    );
    dialog.querySelector('[data-lightbox-prev]')?.addEventListener('click', () => show(current - 1));
    dialog.querySelector('[data-lightbox-next]')?.addEventListener('click', () => show(current + 1));
    dialog.querySelector('[data-lightbox-close]')?.addEventListener('click', () => dialog.close());
    dialog.addEventListener('click', (event) => {
      if (event.target === dialog) dialog.close();
    });
    dialog.addEventListener('keydown', (event) => {
      if (event.key === 'ArrowLeft') show(current - 1);
      if (event.key === 'ArrowRight') show(current + 1);
    });
  }
</script>
