---
import { useStoryblokApi } from '@storyblok/astro'
import StoryblokComponent from '@storyblok/astro/StoryblokComponent.astro'

export async function getStaticPaths() {
  const sbApi = useStoryblokApi();

  const { data } = await sbApi.get("cdn/stories", {
    content_type: "writeupPost",
    version: import.meta.env.DEV ? "draft" : "published",
  });

  const stories = Object.values(data.stories);

  return stories.map((story) => {
    return {
      params: { slug: story.slug },
    };
  });
}

const sbApi = useStoryblokApi();
const { slug } = Astro.params;
const { data } = await sbApi.get(`cdn/stories/writeups/${slug}`, {
  version: import.meta.env.DEV ? "draft" : "published",
});

const story = data.story;

// console.log("Before")
// console.log(story)
// console.log('After')
// console.log(story.tag_list)

---

<StoryblokComponent blok={story.content} tags={story.tag_list} date={story.content.date} link={story.content.medium_link?.url} challenges={story.content.challenges}/>
